<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.meethalfway</groupId>
    <artifactId>meethalfway-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>meethalfway-backend</name>
    <description>Meeting Recommendation Engine backend (Clean Architecture, Spring Boot)</description>

    <!--
        Single-module Maven project. Clean Architecture is enforced at the PACKAGE
        level (domain / application / adapters / config) rather than with separate
        Maven modules, and the inward dependency rule is verified mechanically by
        an ArchUnit test (see ArchitectureRulesTest). This keeps the build simple
        while making the "Domain depends on nothing; Application depends on Domain;
        Adapters depend on both" rule a hard, testable constraint.
    -->

    <properties>
        <!-- Toolchain -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned dependency / plugin versions (no version ranges) -->
        <!-- 3.5.x is the first line with official Java 25 support: its bundled
             ASM parses class-file major version 69, which 3.3.5 could not, so
             component scanning failed to start the context under JDK 25. -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <postgresql.version>42.7.4</postgresql.version>
        <!-- Flyway 10.x is the line managed by the Spring Boot 3.3.5 BOM; pinned
             explicitly per the no-version-ranges convention. Flyway 10 split
             PostgreSQL support into a separate module (flyway-database-postgresql). -->
        <flyway.version>10.17.3</flyway.version>
        <jqwik.version>1.9.1</jqwik.version>
        <!-- 1.4.0+ adds support for Java 25 / class file major version 69;
             1.3.0 cannot parse JDK 25 bytecode and imports zero classes,
             which makes the architecture rules fail with "no classes checked". -->
        <archunit.version>1.5.1</archunit.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.1</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Import the Spring Boot BOM so Spring-managed artifacts are aligned,
                 while our own top-level dependency versions stay explicitly pinned. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web adapter (REST /api/v1) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- Persistence: JPA + PostgreSQL driver -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations: Flyway owns the PostgreSQL schema (ddl-auto=none).
             Flyway 10 requires the dedicated PostgreSQL module alongside the core. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Bean Validation (Jakarta Validation via Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- ==================== Test scope ==================== -->

        <!-- Spring Boot test support (JUnit 5, AssertJ, MockMvc, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- jqwik: property-based testing (MANDATORY for the engine per design) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: enforce the Clean Architecture inward dependency rule -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- Ensure both JUnit Platform (Spring/ArchUnit) and jqwik engines run -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
