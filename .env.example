# Copy to .env and fill in. Keep real values out of version control (Req 11.4).

# PostgreSQL
POSTGRES_DB=meethalfway
POSTGRES_USER=meethalfway
POSTGRES_PASSWORD=change-me

# Explicit CORS allow-list — comma-separated, no wildcard (Req 11.3)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Backend-only third-party provider keys (Req 11.4) — never exposed to frontend
ROUTING_PROVIDER_API_KEY=
GEOCODING_PROVIDER_API_KEY=
