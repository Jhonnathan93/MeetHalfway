{
  "version": "v1",
  "hooks": [
    {
      "name": "Progressive conventional commits",
      "trigger": "PostFileSave",
      "matcher": "\\.(java|ts|tsx|js|jsx|vue|css|scss|json|ya?ml|md|sql)$",
      "action": {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .kiro/hooks/scripts/progressive-commit.ps1"
      }
    }
  ]
}
